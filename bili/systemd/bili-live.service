[Unit]
Description=Bili 直播推流 push.sh（TikTok 直播源 -> Bilibili）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=%h/.config/bili/live.env
EnvironmentFile=-%h/.config/bili/aliyun.env
ExecStart=@PROJECT_ROOT@/push.sh $TARGET
Restart=always
RestartSec=10
# push.sh 长时间取不到源时 exit 75 主动放弃，不再拉起（见 push.sh note_offline）
RestartPreventExitStatus=75
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@PROJECT_ROOT@/logs

[Install]
WantedBy=default.target

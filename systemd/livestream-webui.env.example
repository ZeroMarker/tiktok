LIVE_WEBUI_HOST=127.0.0.1
LIVE_WEBUI_PORT=8766
RECORDINGS_DIR=/root/tiktok/recordings

# 由 livestream-webui.service 与 livestream-recorderd.service **共用**：
# - LIVE_WEBUI_HOST/PORT 只对 WebUI 生效；
# - RECORDINGS_DIR 两个服务都要（引擎写产物、WebUI 列文件）；
# - RECORDERD_SOCKET 可选，默认 <STATE_DIR>/run/recorderd.sock。
# RECORDERD_SOCKET=/home/ubuntu/tiktok/state/run/recorderd.sock

# 认证已移除：WebUI 设计为仅在内网/隧道/受控反代后使用。
# 如需恢复认证，在 webui/server.py 的 Handler.authenticated() 中启用校验，
# 并在此重新设置 LIVE_WEBUI_TOKEN。
